name: DoomWatch Markets Collector

on:
  schedule:
    - cron: "17 */6 * * *"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: doomwatch-markets-collector
  cancel-in-progress: false

jobs:
  collect:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Check out DoomWatch
        uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Collect market intelligence
        run: python markets_collector.py

      - name: Commit updated market history
        run: |
          git config user.name "DoomWatch Markets Collector"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add data/markets.json

          if git diff --cached --quiet; then
            echo "No market data changes to commit"
            exit 0
          fi

          git commit -m "Update DoomWatch market intelligence"

          git pull --rebase origin main
          git push origin HEAD:main
